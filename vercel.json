{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "v2": false
    }
  },
  "rewrites": [
    {
      "source": "/:page(gpu|cpu|mobo|ram|storage|psu|case|fan|cooler|monitor|mouse|headphones|builder|parts|compare|search|about|contact|privacy|how-prices)",
      "destination": "/index.html"
    },
    {
      "source": "/:cat(gpu|cpu|mobo|ram|storage|psu|case|fan|cooler|monitor|mouse|headphones)/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/img/:path*",
      "destination": "https://teoampatzis.github.io/builddraft-images/img/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-ZWu3Nh+DuBX0DQ1HBnq+UbYOC7hDpL3ojIgdH8vg1Sk=' 'sha256-Fq0rUidxsLV1WrrQNbBH0SX10fNskQ4ucCIkhMi/Zr4='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/fonts/(.*).woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=86400"
        }
      ]
    }
  ]
}
