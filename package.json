{
  "name": "gpu-prices-gr",
  "private": true,
  "version": "0.1.0",
  "description": "BuildDraft.gr — PC hardware prices in the Greek market from Skroutz, BestPrice, Shopflix, Snif and e-shop.gr",
  "author": "Theodoros Ampatzis (https://github.com/TeoAmpatzis)",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:local": "npm run build && vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint .",
    "lint:baseline": "eslint . --suppressions-location scripts/lint/no-suppressions.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.11",
    "vitest": "^3.2.7"
  }
}
